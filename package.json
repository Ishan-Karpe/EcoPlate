{
  "name": "ecoplate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint \"src/**/*.{js,ts}\" \"tests/**/*.{js,ts}\" \"*.{js,ts,mjs,cjs}\" --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"src/**/*.{js,ts,svelte,css}\" \"tests/**/*.{js,ts}\" \"*.{js,ts,mjs,cjs,json,md,html}\" \".sisyphus/plans/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,svelte,css}\" \"tests/**/*.{js,ts}\" \"*.{js,ts,mjs,cjs,json,md,html}\" \".sisyphus/plans/**/*.md\"",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run check && npm run lint && npm run format:check && npm run test:unit && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.98.0",
    "@sveltejs/kit": "^2.53.4",
    "chart.js": "^4.5.1",
    "daisyui": "^5.5.19",
    "jsqr": "^1.4.0",
    "lucide-svelte": "^0.575.0",
    "qrcode": "^1.5.4",
    "svelte": "^5.53.6",
    "svelte-motion": "^0.12.2",
    "svelte-sonner": "^1.0.7",
    "svelte5-chartjs": "^1.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@sveltejs/adapter-vercel": "^6.3.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.1.12",
    "@typescript-eslint/parser": "^8.56.1",
    "@vite-pwa/sveltekit": "^1.1.0",
    "eslint": "^10.0.2",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.0",
    "svelte-check": "^4.4.4",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "6.3.5",
    "vitest": "^4.0.18"
  }
}
